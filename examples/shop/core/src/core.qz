package org.example.shop.core

/// A price in cents, shown with two decimals.
pub struct Price {
    cents: int
    currency: str = "EUR"
}

impl Price {
    pub fn of(cents: int) -> Price {
        return Price(cents)
    }

    pub fn show(self) -> str {
        let units = self.cents / 100
        let rest = self.cents % 100
        return "{units}.{rest:02} {self.currency}"
    }
}

pub fn welcome(name: str) -> str {
    return "Welcome to the shop, {name}!"
}
