# Script mode: OUTPUT gets each INPUTS file as a string constant named after it (qiln.qzi is kQilnQzi).
set(text "#pragma once\n\n#include <string_view>\n\nnamespace qiln::api {\n")
foreach(input IN LISTS INPUTS)
    file(READ "${input}" content)
    get_filename_component(leaf "${input}" NAME)
    string(REGEX REPLACE "[^A-Za-z0-9]+" ";" parts "${leaf}")
    set(id "k")
    foreach(part IN LISTS parts)
        string(SUBSTRING "${part}" 0 1 first)
        string(SUBSTRING "${part}" 1 -1 rest)
        string(TOUPPER "${first}" first)
        string(APPEND id "${first}${rest}")
    endforeach()
    string(APPEND text "\ninline constexpr std::string_view ${id} = R\"qiln(${content})qiln\";\n")
endforeach()
string(APPEND text "\n} // namespace qiln::api\n")
file(WRITE "${OUTPUT}.tmp" "${text}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
